    },
    {
      "id": "b000013",
      "kind": "paragraph",
      "start_line": 46,
      "end_line": 48,
      "raw": "Generation History remains PNG; IISC conversion belongs to editor persistence.\nInstaller smoke fixtures copy bounded embedding/configuration assets and exclude\nbackend weights larger than 64 MiB. They never copy multi-gigabyte developer models.\n"
    }
