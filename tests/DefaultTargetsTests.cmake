if(NOT EXISTS "${BUILD_ROOT}/build.ninja")
    message(STATUS "Default-target graph check applies to Ninja builds")
    return()
endif()
file(STRINGS "${BUILD_ROOT}/build.ninja" _all REGEX "^build all: phony ")
if(NOT _all)
    message(FATAL_ERROR "Ninja default build graph not found")
endif()
foreach(_manual NativeCacheIntegration NativeComponentMountIntegration NativeVaeDecodeProbe NativeVaeRoundTripProbe NativeImg2ImgSmoke NativeWeightReadBenchmark)
    if(" ${_all} " MATCHES " ${_manual} ")
        message(FATAL_ERROR "Manual target ${_manual} is in the default build")
    endif()
endforeach()
file(READ "${BUILD_ROOT}/CTestTestfile.cmake" _tests)
if(_tests MATCHES "PYTHONPYCACHEPREFIX=[^\n]*build/pycache")
    message(FATAL_ERROR "Python test bytecode is configured under the build tree")
endif()
if(NOT _tests MATCHES "PYTHONDONTWRITEBYTECODE=1")
    message(FATAL_ERROR "Python tests are missing the no-bytecode policy")
endif()
