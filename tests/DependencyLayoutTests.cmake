if(NOT IS_DIRECTORY "${MLX_SOURCE}")
    message(FATAL_ERROR "The MLX source directory is missing")
endif()
file(REAL_PATH "${MLX_SOURCE}" _source)
file(REAL_PATH "${BUILD_ROOT}" _build)
cmake_path(IS_PREFIX _build "${_source}" NORMALIZE _in_build)
if(_in_build AND NOT SOURCE_OVERRIDE)
    message(FATAL_ERROR "Default MLX source is still inside the build tree")
endif()
if(NOT SOURCE_OVERRIDE)
    file(REAL_PATH "${SOURCE_ROOT}/resources/dependencies/mlx-src" _resources)
    cmake_path(IS_PREFIX _resources "${_source}" NORMALIZE _in_resources)
    if(NOT _in_resources)
        message(FATAL_ERROR "Default MLX source is outside project resources")
    endif()
endif()
