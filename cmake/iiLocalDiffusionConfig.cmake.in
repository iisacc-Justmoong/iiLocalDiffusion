@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/iiLocalDiffusionTargets.cmake")

# LIBRARY_PATH can make the package directory implicit to the linker without
# making it a runtime search path for dyld. Restore only that omitted RPATH.
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND TARGET iiLocalDiffusion::iiLocalDiffusion)
    set(_iild_package_library_directory "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
    list(FIND CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES
        "${_iild_package_library_directory}" _iild_implicit_link_directory_index)
    if(NOT _iild_implicit_link_directory_index EQUAL -1)
        set_property(TARGET iiLocalDiffusion::iiLocalDiffusion APPEND PROPERTY
            INTERFACE_LINK_OPTIONS "LINKER:-rpath,${_iild_package_library_directory}")
    endif()
    unset(_iild_implicit_link_directory_index)
    unset(_iild_package_library_directory)
endif()

check_required_components(iiLocalDiffusion)
