@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiFileProviderNative 0.8.2 CONFIG HINTS "$ENV{IIFILEPROVIDER_PREFIX}" "$ENV{HOME}/.local/SDK/iiFileProvider")






if(NOT TARGET iiLocalDiffusion::CryptoRuntime)
    if(@IILD_PACKAGED_CRYPTO@)
        add_library(iiLocalDiffusion::CryptoRuntime SHARED IMPORTED)
        set_target_properties(iiLocalDiffusion::CryptoRuntime PROPERTIES
            IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@IILD_CRYPTO_RUNTIME_NAME@")
    else()
        find_dependency(OpenSSL COMPONENTS Crypto)
        add_library(iiLocalDiffusion::CryptoRuntime INTERFACE IMPORTED)
        set_target_properties(iiLocalDiffusion::CryptoRuntime PROPERTIES
            INTERFACE_LINK_LIBRARIES OpenSSL::Crypto)
    endif()
endif()
find_package(json-c CONFIG QUIET)
if(NOT TARGET json-c::json-c)
    find_dependency(PkgConfig)
    pkg_check_modules(JSON_C REQUIRED IMPORTED_TARGET json-c>=0.18)
endif()
set(iiLocalDiffusion_NATIVE_DIFFUSION @IILD_ENABLE_NATIVE_DIFFUSION@)
set(iiLocalDiffusion_GENERATION_RESOURCES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/iiLocalDiffusion/resources")
include("${CMAKE_CURRENT_LIST_DIR}/IildGenerationResources.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/iiLocalDiffusionTargets.cmake")

# Another backend SDK can share a directory with an older diffusion library.
# Keep explicitly selected native packages ahead of automatically collected
# backend paths, including directories made implicit by LIBRARY_PATH.
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND TARGET iiLocalDiffusion::iiLocalDiffusion)
    set(_iild_package_library_directory "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
    set(_iild_runtime_options "LINKER:-rpath,${_iild_package_library_directory}")
    get_target_property(_iild_provider_type iiFileProvider::Native TYPE)
    if(_iild_provider_type STREQUAL "SHARED_LIBRARY")
        list(PREPEND _iild_runtime_options "LINKER:-rpath,$<TARGET_FILE_DIR:iiFileProvider::Native>")
    endif()
    set_property(TARGET iiLocalDiffusion::iiLocalDiffusion APPEND PROPERTY
        INTERFACE_LINK_OPTIONS ${_iild_runtime_options})
    unset(_iild_provider_type)
    unset(_iild_runtime_options)
    unset(_iild_package_library_directory)
endif()

check_required_components(iiLocalDiffusion)
