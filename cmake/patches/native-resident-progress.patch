 public:
     ResidentMemoryMmapWrapper(void* data, size_t size) : MmapWrapper(data, size) {}
     ~ResidentMemoryMmapWrapper() override { std::free(data_); }
+    bool copy_data(void* buffer, size_t bytes, size_t offset) const override {
+        if (offset > size_ || bytes > size_ - offset) return false;
+        auto* destination = static_cast<uint8_t*>(buffer);
+        while (bytes) {
+            if (sd_should_abort()) return false;
+            const size_t chunk = std::min<size_t>(bytes, 8 * 1024 * 1024);
+            std::memcpy(destination, data() + offset, chunk);
+            destination += chunk;
+            offset += chunk;
+            bytes -= chunk;
+        }
+        return true;
+    }
 };
