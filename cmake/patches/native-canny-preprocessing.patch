+static inline void threshold_hystersis(sd::Tensor<float>* img, float high_threshold, float low_threshold, float weak, float strong) {
+    GGML_ASSERT(img != nullptr);
+    if (img->empty()) return;
+    float max_value = 0.0f;
+    for (int64_t i = 0; i < img->numel(); ++i) max_value = std::max(max_value, (*img)[i]);
+    if (!(max_value > 0) || !std::isfinite(max_value)) {
+        std::fill(img->values().begin(), img->values().end(), 0.0f);
+        return;
+    }
+    const float ht = max_value * high_threshold;
+    const float lt = ht * low_threshold;
+    const int64_t width = img->shape()[0], height = img->shape()[1];
+    std::vector<std::pair<int64_t, int64_t>> pending;
+    for (int64_t y = 0; y < height; ++y) {
+        for (int64_t x = 0; x < width; ++x) {
+            const float value = preprocessing_get_4d(*img, x, y);
+            const bool interior = x >= 3 && x <= width - 3 && y >= 3 && y <= height - 3;
+            const float classified = !interior || value <= 0 || value < lt ? 0.0f
+                : value >= ht ? strong : weak;
+            preprocessing_set_4d(*img, classified, x, y);
+            if (classified == strong) pending.emplace_back(x, y);
+        }
+    }
+    // Follow all eight-connected weak edges, independent of raster scan order.
+    for (size_t i = 0; i < pending.size(); ++i) {
+        const auto [x, y] = pending[i];
+        for (int64_t dy = -1; dy <= 1; ++dy) {
+            for (int64_t dx = -1; dx <= 1; ++dx) {
+                const int64_t nx = x + dx, ny = y + dy;
+                if (nx < 0 || nx >= width || ny < 0 || ny >= height) continue;
+                if (preprocessing_get_4d(*img, nx, ny) == weak) {
+                    preprocessing_set_4d(*img, strong, nx, ny);
+                    pending.emplace_back(nx, ny);
+                }
+            }
+        }
+    }
+    for (int64_t i = 0; i < img->numel(); ++i) if ((*img)[i] != strong) (*img)[i] = 0.0f;
+}
