diff --git a/src/runtime/ip_adapter_validation.hpp b/src/runtime/ip_adapter_validation.hpp
new file mode 100644
--- /dev/null
+++ b/src/runtime/ip_adapter_validation.hpp
@@ -0,0 +1,27 @@
+#pragma once
+#include "ggml.h"
+#include <map>
+#include <string>
+
+// Projection weights alone are not an IP-Adapter. Every UNet attn2 needs its
+// own image K/V pair; partial attachment must not silently lose conditioning.
+inline bool sd_valid_ip_attention_bindings(const std::map<std::string, ggml_tensor*>& tensors,
+                                            int64_t image_width) {
+    if (image_width < 1) return false;
+    size_t layers = 0;
+    for (const auto& [name, text_key] : tensors) {
+        const std::string suffix = "attn2.to_k.weight";
+        if (name.size() < suffix.size() || name.compare(name.size() - suffix.size(), suffix.size(), suffix) != 0) continue;
+        ++layers;
+        if (!text_key) return false;
+        const auto prefix = name.substr(0, name.size() - std::string("to_k.weight").size());
+        for (const auto* role : {"to_k_ip.weight", "to_v_ip.weight"}) {
+            const auto found = tensors.find(prefix + role);
+            if (found == tensors.end() || !found->second) return false;
+            const auto* tensor = found->second;
+            if (tensor->ne[0] != image_width || tensor->ne[1] != text_key->ne[1]
+                || tensor->ne[2] != 1 || tensor->ne[3] != 1) return false;
+        }
+    }
+    return layers > 0;
+}
