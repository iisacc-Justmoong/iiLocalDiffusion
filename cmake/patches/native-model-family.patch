+SD_API const char* sd_get_model_family(const sd_ctx_t* sd_ctx) {
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr) return "other";
+    if (sd_version_is_sdxl(sd_ctx->sd->version)) return "sdxl-base";
+    if (sd_version_is_sd1(sd_ctx->sd->version)) return "sd15";
+    if (sd_version_is_sd2(sd_ctx->sd->version)) return "sd2";
+    if (sd_version_is_sd3(sd_ctx->sd->version)) return "sd3";
+    switch (sd_ctx->sd->version) {
+        case VERSION_FLUX:
+        case VERSION_FLUX_FILL:
+        case VERSION_FLUX_CONTROLS: return "flux1";
+        case VERSION_FLUX2:
+        case VERSION_FLUX2_KLEIN: return "flux2";
+        case VERSION_QWEN_IMAGE:
+        case VERSION_QWEN_IMAGE_LAYERED: return "qwen-image";
+        case VERSION_Z_IMAGE: return "z-image";
+        case VERSION_CHROMA_RADIANCE: return "chroma-radiance";
+        default: break;
+    }
+    return "other";
+}
