@@ -20,3 +20,31 @@
 #include "stable-diffusion.h"
 
+class ResidentMemoryMmapWrapper final : public MmapWrapper {
+public:
+    ResidentMemoryMmapWrapper(void* data, size_t size) : MmapWrapper(data, size) {}
+    ~ResidentMemoryMmapWrapper() override { std::free(data_); }
+};
+
+static std::unique_ptr<MmapWrapper> load_file_into_resident_memory(const std::string& filename) {
+    std::ifstream input(filename, std::ios::binary | std::ios::ate);
+    if (!input) return nullptr;
+    const auto end = static_cast<std::streamoff>(input.tellg());
+    if (end <= 0 || static_cast<uintmax_t>(end) > SIZE_MAX) return nullptr;
+    const size_t size = static_cast<size_t>(end);
+    void* memory = std::malloc(size);
+    if (!memory) return nullptr;
+    input.seekg(0, std::ios::beg);
+    size_t offset = 0;
+    while (offset < size) {
+        if (sd_should_abort()) { std::free(memory); return nullptr; }
+        const size_t chunk = std::min<size_t>(32 * 1024 * 1024, size - offset);
+        input.read(static_cast<char*>(memory) + offset, static_cast<std::streamsize>(chunk));
+        if (static_cast<size_t>(input.gcount()) != chunk) { std::free(memory); return nullptr; }
+        offset += chunk;
+    }
+    input.close();
+    LOG_INFO("copied model file into anonymous memory: %s (%zu bytes)", filename.c_str(), size);
+    return std::make_unique<ResidentMemoryMmapWrapper>(memory, size);
+}
