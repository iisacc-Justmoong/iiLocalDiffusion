+SD_API bool sd_set_freeu(sd_ctx_t* sd_ctx, bool enabled) {
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr) return false;
+    auto unet = std::dynamic_pointer_cast<UNetModelRunner>(sd_ctx->sd->diffusion_model);
+    return unet ? unet->configure_freeu(enabled) : !enabled;
+}
