+static adetailer_ctx_t* create_adetailer(const char* path, int threads,
+                                         const char* backend, const char* params_backend, bool resident) {
+    if (!path || !*path) return nullptr;
+    auto context = std::unique_ptr<adetailer_ctx_t, decltype(&free_adetailer_ctx)>(
+        static_cast<adetailer_ctx_t*>(calloc(1, sizeof(adetailer_ctx_t))), free_adetailer_ctx);
