+        return context.release();
+    } catch (const std::exception& error) {
+        LOG_ERROR("ADetailer preparation failed: %s", error.what());
+        return nullptr;
+    }
+}
+adetailer_ctx_t* new_adetailer_ctx(const char* path, int threads,
