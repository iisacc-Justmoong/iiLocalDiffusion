+// Probe only a bounded JSON prefix. The index reader validates weight_map;
+// iiLocalDiffusion validates the complete indexed shard set before loading.
+static bool iild_index_json_candidate(const std::string& path) {
+    std::ifstream file(path, std::ios::binary | std::ios::ate);
+    if (!file) return false;
+    const auto size = file.tellg();
+    if (size <= 0 || size > 64 * 1024 * 1024) return false;
+    file.seekg(0);
+    char c = 0;
+    for (int i = 0; i < 4096 && file.get(c); ++i) {
+        if (c == ' ' || c == '\t' || c == '\r' || c == '\n') continue;
+        return c == '{';
+    }
+    return false;
+}
