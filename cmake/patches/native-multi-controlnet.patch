+    bool prepare_control_nets(const char* const* paths, uint32_t count) {
+        if (count > 64 || (count && !paths)) return false;
+        if (!count) {
+            control_stack.set(nullptr, 0);
+            control_models.clear(); control_model_paths.clear(); return true;
+        }
+        if (version != VERSION_SD1 && version != VERSION_SDXL
+            && version != VERSION_SDXL_SSD1B && version != VERSION_SDXL_VEGA) return false;
+        std::vector<std::string> requested;
+        for (uint32_t i = 0; i < count; ++i) {
+            if (!paths[i] || !paths[i][0]) return false;
+            requested.emplace_back(paths[i]);
+        }
+        if (requested == control_model_paths && control_models.size() == count) return true;
+        if (!ensure_backend_pair(SDBackendModule::CONTROL_NET)
+            || backend_manager.params_backend_is_disk(SDBackendModule::CONTROL_NET)) return false;
+        const auto runtime = backend_for(SDBackendModule::CONTROL_NET);
+        const auto params = params_backend_for(SDBackendModule::CONTROL_NET);
+        std::vector<ResidentControl> next;
+        for (const auto& path : requested) {
+            if (sd_should_abort()) return false;
+            ResidentControl model;
+            model.manager = std::make_shared<ModelManager>();
+            model.manager->set_n_threads(n_threads);
+            model.manager->set_enable_mmap(false);
+            auto& loader = model.manager->loader();
+            loader.set_resident_memory(true);
+            if (!loader.init_from_file_and_convert_name(path)) return false;
+            model.runner = std::make_shared<ControlNet>(runtime, params,
+                loader.get_tensor_storage_map(), version, "", model.manager);
+            model.runner->set_max_graph_vram_bytes(max_graph_vram_bytes_for_module(SDBackendModule::CONTROL_NET));
+            if (diffusion_conv_direct) model.runner->set_conv2d_direct_enabled(true);
+            std::map<std::string, ggml_tensor*> tensors;
+            model.runner->get_param_tensors(tensors);
+            if (!model.manager->register_param_tensors("ControlNet", std::move(tensors),
+                    ModelManager::ResidencyMode::ParamBackend, runtime, params)
+                || !model.manager->validate_registered_tensors()
+                || !model.manager->load_all_params_eagerly()) return false;
+            next.push_back(std::move(model));
+        }
+        if (sd_should_abort()) return false;
+        control_stack.set(nullptr, 0);
+        control_models = std::move(next);
+        control_model_paths = std::move(requested);
+        return true;
+    }
