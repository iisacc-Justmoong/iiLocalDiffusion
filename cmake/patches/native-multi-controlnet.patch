+SD_API bool sd_prepare_control_nets(sd_ctx_t* ctx, const char* const* paths, uint32_t count) {
+    if (!ctx || !ctx->sd) return false;
+    try { return ctx->sd->prepare_control_nets(paths, count); }
+    catch (const std::exception& error) { LOG_ERROR("multi-ControlNet preparation failed: %s", error.what()); return false; }
+}
+
+SD_API bool sd_set_control_net_inputs(sd_ctx_t* ctx, const sd_control_input_t* inputs, uint32_t count) {
+    if (!ctx || !ctx->sd || (count && count != ctx->sd->control_models.size())) return false;
+    try {
+        if (!ctx->sd->control_stack.set(inputs, count)) return false;
+        ctx->sd->end_control_stack_pass();
+        return true;
+    } catch (const std::exception& error) { LOG_ERROR("multi-ControlNet inputs failed: %s", error.what()); return false; }
+}
