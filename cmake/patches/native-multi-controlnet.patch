diff --git a/src/runtime/control_stack.hpp b/src/runtime/control_stack.hpp
new file mode 100644
--- /dev/null
+++ b/src/runtime/control_stack.hpp
@@ -0,0 +1,90 @@
+#pragma once
+#include "stable-diffusion.h"
+#include "core/util.h"
+#include "runtime/control_region_mask.hpp"
+#include <cmath>
+#include <optional>
+#include <vector>
+
+// Request-owned inputs; model lifetime is owned separately by the runtime.
+class ControlNetStack {
+    struct Layer {
+        int width = 0, height = 0;
+        std::vector<uint8_t> rgb;
+        float weight = 1;
+        ControlRegionMask mask;
+        sd::Tensor<float> hint;
+        int target_width = 0, target_height = 0;
+    };
+    std::vector<Layer> layers_;
+public:
+    bool active() const { return !layers_.empty(); }
+    size_t size() const { return layers_.size(); }
+    sd_image_t first_image() {
+        if (layers_.empty()) return {};
+        auto& layer = layers_.front();
+        return {uint32_t(layer.width), uint32_t(layer.height), 3, layer.rgb.data()};
+    }
+
+    bool set(const sd_control_input_t* inputs, uint32_t count) {
+        if (count > 64 || (count && !inputs)) return false;
+        std::vector<Layer> next;
+        for (uint32_t i = 0; i < count; ++i) {
+            const auto& input = inputs[i];
+            if (!input.image.data || input.image.width < 1 || input.image.width > 2048
+                || input.image.height < 1 || input.image.height > 2048 || input.image.channel != 3
+                || !std::isfinite(input.strength) || input.strength < 0 || input.strength > 2) return false;
+            Layer layer;
+            if (!layer.mask.set(input.mask)) return false;
+            layer.width = int(input.image.width); layer.height = int(input.image.height);
+            layer.weight = input.strength;
+            layer.rgb.assign(input.image.data, input.image.data + size_t(layer.width) * layer.height * 3);
+            next.push_back(std::move(layer));
+        }
+        layers_ = std::move(next);
+        return true;
+    }
+    void end_pass() {
+        for (auto& layer : layers_) {
+            layer.hint = {}; layer.target_width = layer.target_height = 0;
+        }
+    }
+    // Compute is called for EVERY selected model, including zero-weight models.
+    // Results remain local until all models succeed and match residual topology.
+    template<class Compute>
+    std::optional<std::vector<sd::Tensor<float>>> compute(int width, int height, Compute&& run) {
+        if (!active() || width < 1 || height < 1 || width > 4096 || height > 4096) return std::nullopt;
+        std::vector<sd::Tensor<float>> total;
+        for (size_t index = 0; index < layers_.size(); ++index) {
+            if (sd_should_abort()) return std::nullopt;
+            auto& layer = layers_[index];
+            if (layer.target_width != width || layer.target_height != height) {
+                layer.hint = sd_image_to_tensor({uint32_t(layer.width), uint32_t(layer.height), 3, layer.rgb.data()}, width, height);
+                if (layer.hint.empty()) return std::nullopt;
+                layer.target_width = width; layer.target_height = height;
+            }
+            auto result = run(index, layer.hint);
+            if (!result || result->empty() || !layer.mask.apply(*result)) return std::nullopt;
+            if (!total.empty() && total.size() != result->size()) return std::nullopt;
+            if (total.empty()) {
+                for (const auto& tensor : *result) {
+                    if (tensor.empty() || tensor.dim() < 2) return std::nullopt;
+                    total.emplace_back(tensor.shape());
+                }
+            }
+            for (size_t residual = 0; residual < total.size(); ++residual) {
+                auto& destination = total[residual];
+                const auto& source = (*result)[residual];
+                if (destination.shape() != source.shape()) return std::nullopt;
+                for (size_t i = 0; i < source.values().size(); ++i) {
+                    const float value = source.values()[i];
+                    if (!std::isfinite(value)) return std::nullopt;
+                    destination.values()[i] += value * layer.weight;
+                    if (!std::isfinite(destination.values()[i])) return std::nullopt;
+                }
+            }
+        }
+        if (sd_should_abort()) return std::nullopt;
+        return total;
+    }
+};
