+static std::shared_ptr<void> allocate_resident_source(size_t size) {
+    const size_t alignment = ggml_backend_buft_get_alignment(ggml_backend_cpu_buffer_type());
+    if (alignment == 0 || size > SIZE_MAX - (alignment - 1)) return {};
+    size_t space = size + alignment - 1;
+    const std::shared_ptr<void> allocation(std::malloc(space), std::free);
+    if (!allocation) return {};
+    void* aligned = allocation.get();
+    if (!std::align(alignment, size, aligned, space)) return {};
+    // Aliasing ownership keeps the raw allocation alive and frees its original
+    // address while exposing the backend-aligned anonymous model bytes.
+    return std::shared_ptr<void>(allocation, aligned);
+}
