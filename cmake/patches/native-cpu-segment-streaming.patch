+bool ModelManager::requires_disk_streaming(const std::vector<ggml_tensor*>& tensors) const {
+    std::vector<TensorState*> states;
+    if (!resolve_required_tensor_states(tensors, states)) return false;
+    return std::any_of(states.begin(), states.end(), [](const TensorState* state) {
+        return state != nullptr && state->residency_mode == ResidencyMode::Disk;
+    });
+}
