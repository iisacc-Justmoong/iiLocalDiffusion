+bool sd_model_has_embedded_llm(const char* model_path, bool* embedded) {
+    if (embedded == nullptr) return false;
+    *embedded = false;
+    if (model_path == nullptr || *model_path == '\0') return false;
+    ModelLoader loader;
+    if (!loader.init_from_file_and_convert_name(model_path)) return false;
+    const auto& storage = loader.get_tensor_storage_map();
+    // A partial embedded encoder is preserved and rejected by full assembly;
+    // it must never be silently replaced with a different resource.
+    *embedded = std::any_of(storage.begin(), storage.end(), [](const auto& item) {
+        return starts_with(item.first, "text_encoders.llm.");
+    });
+    return true;
+}
+
+bool sd_model_validate_krea2_llm(const char* llm_path) {
+    if (llm_path == nullptr || *llm_path == '\0') return false;
+    ModelLoader loader;
+    if (!loader.init_from_file_and_convert_name(llm_path, "text_encoders.llm.", VERSION_KREA2)) return false;
+    const auto& storage = loader.get_tensor_storage_map();
+    const auto embedding = storage.find("text_encoders.llm.model.embed_tokens.weight");
+    if (embedding == storage.end() || embedding->second.ne[0] != 2560 || embedding->second.ne[1] != 151936 ||
+        storage.find("text_encoders.llm.model.layers.35.self_attn.q_proj.weight") == storage.end() ||
+        storage.find("text_encoders.llm.model.layers.36.self_attn.q_proj.weight") != storage.end()) return false;
+    std::unique_ptr<ggml_backend, decltype(&ggml_backend_free)> cpu(ggml_backend_cpu_init(), ggml_backend_free);
+    if (!cpu) return false;
+    LLMEmbedder encoder(cpu.get(), storage, VERSION_KREA2, "", true);
+    std::map<std::string, ggml_tensor*> required;
+    encoder.get_param_tensors(required);
+    if (required.empty()) return false;
+    for (const auto& [name, tensor] : required) {
+        const auto found = storage.find(name);
+        if (found == storage.end() || !std::equal(tensor->ne, tensor->ne + GGML_MAX_DIMS, found->second.ne)) {
+            LOG_WARN("Krea2 Qwen3-VL-4B tensor contract mismatch: %s", name.c_str());
+            return false;
+        }
+    }
+    return true;
 }
 
