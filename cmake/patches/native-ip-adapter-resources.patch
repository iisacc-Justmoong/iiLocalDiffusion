+++ b/src/runtime/ip_adapter_runtime.hpp
@@ -0,0 +1,138 @@
+#pragma once
+#include "stable-diffusion.h"
+#include "conditioning/conditioner.hpp"
+#include "model/adapter/ip_adapter.hpp"
+#include "runtime/control_region_mask.hpp"
+#include <set>
+
+// Shared by legacy and indexed adapters so Classic/Plus preparation cannot drift.
+inline bool sd_compute_ip_tokens(FrozenCLIPVisionEmbedder* clip_vision, IPAdapter::IPAdapterRunner* ip_adapter,
+    int n_threads, const sd_image_t& image, float strength,
+    sd::Tensor<float>& ip_adapter_tokens, sd::Tensor<float>& ip_adapter_uncond_tokens) {
+    ip_adapter_tokens = {};
+    ip_adapter_uncond_tokens = {};
+    struct EndIPRunners {
+        GGMLRunner* vision;
+        GGMLRunner* adapter;
+        ~EndIPRunners() {
+            if (vision) vision->runner_end();
+            if (adapter) adapter->runner_end();
+        }
+    } finish{clip_vision, ip_adapter};
+    if (!image.data && !image.width && !image.height && !image.channel) return true;
+    const auto fail = [](const char* reason) {
+        LOG_ERROR("IP-Adapter preparation failed: %s", reason); return false;
+    };
+    if (!image.data || image.width < 1 || image.width > 2048
+        || image.height < 1 || image.height > 2048 || image.channel != 3
+        || !std::isfinite(strength) || strength < 0.f || strength > 2.f)
+        return fail("invalid RGB image or strength");
+    if (!ip_adapter || !clip_vision) return fail("adapter and CLIP vision weights are required");
+    if (sd_should_abort()) return fail("cancelled");
+    const bool plus = ip_adapter->is_plus;
+    auto pixels = clip_preprocess(sd_image_to_tensor(image),
+        clip_vision->vision_model.image_size, clip_vision->vision_model.image_size);
+    if (pixels.empty()) return fail("image preprocessing");
+    const auto finite = [](const sd::Tensor<float>& tensor) {
+        return !tensor.empty() && std::all_of(tensor.values().begin(), tensor.values().end(),
+            [](float value) { return std::isfinite(value); });
+    };
+    const int64_t input_width = plus ? ip_adapter->resampler.embed_dim : ip_adapter->image_proj.clip_dim;
+    const int64_t output_width = plus ? ip_adapter->resampler.output_dim : ip_adapter->image_proj.ctx_dim;
+    const auto valid_embedding = [&](const sd::Tensor<float>& tensor) {
+        return finite(tensor) && tensor.dim() >= 1 && tensor.shape()[0] == input_width
+            && (plus ? tensor.dim() >= 2 : tensor.numel() == input_width);
+    };
+    const auto valid_tokens = [&](const sd::Tensor<float>& tensor) {
+        return finite(tensor) && tensor.dim() >= 2 && tensor.shape()[0] == output_width
+            && tensor.shape()[1] == ip_adapter->num_tokens
+            && tensor.numel() == output_width * ip_adapter->num_tokens;
+    };
+    auto embed = clip_vision->compute(n_threads, pixels, !plus, plus ? 2 : -1);
+    if (!valid_embedding(embed) || sd_should_abort()) return fail("conditional vision encoding");
+    auto conditional = ip_adapter->compute(n_threads, embed);
+    if (!valid_tokens(conditional) || sd_should_abort()) return fail("conditional image projection");
+    // Plus conditions on the CLIP hidden states of zero NORMALIZED pixels,
+    // not a zero embedding or a black RGB image passed through normalization.
+    auto uncond_embed = plus
+        ? clip_vision->compute(n_threads, sd::Tensor<float>::zeros_like(pixels), false, 2)
+        : sd::Tensor<float>::zeros_like(embed);
+    if (!valid_embedding(uncond_embed) || sd_should_abort()) return fail("unconditional vision encoding");
+    auto unconditional = ip_adapter->compute(n_threads, uncond_embed);
+    if (!valid_tokens(unconditional) || unconditional.shape() != conditional.shape() || sd_should_abort())
+        return fail("unconditional image projection");
+    ip_adapter_tokens = std::move(conditional);
+    ip_adapter_uncond_tokens = std::move(unconditional);
+    LOG_INFO("IP-Adapter: %lld image tokens, strength %.2f",
+             (long long)ip_adapter_tokens.shape()[1], strength);
+    return true;
+}
+
+class IPAdapterStack {
+    struct Input {
+        uint32_t slot = 0;
+        uint32_t width = 0, height = 0;
+        std::vector<uint8_t> rgb;
+        float strength = 1;
+        bool masked = false;
+        ControlRegionMask mask;
+    };
+    std::vector<Input> inputs_;
+    std::vector<std::pair<sd::Tensor<float>, sd::Tensor<float>>> tokens_;
+    std::vector<IPAdapterInput> positive_, negative_;
+    void clear_tokens() { positive_.clear(); negative_.clear(); tokens_.clear(); }
+public:
+    struct Model {
+        std::shared_ptr<FrozenCLIPVisionEmbedder> vision;
+        std::shared_ptr<IPAdapter::IPAdapterRunner> projection;
+    };
+    std::vector<Model> models; // Context lifetime, never cleared by request cleanup.
+    bool active() const { return !inputs_.empty(); }
+    const std::vector<IPAdapterInput>& views(bool unconditional) const {
+        return unconditional ? negative_ : positive_;
+    }
+    bool set(const sd_ip_adapter_input_t* inputs, uint32_t count) {
+        if (count > 64 || (count && !inputs)) return false;
+        std::vector<Input> next;
+        std::set<uint32_t> slots;
+        for (uint32_t i = 0; i < count; ++i) {
+            const auto& in = inputs[i];
+            if (in.slot >= models.size() || !slots.insert(in.slot).second
+                || !in.image.data || in.image.channel != 3 || in.image.width < 1 || in.image.width > 2048
+                || in.image.height < 1 || in.image.height > 2048
+                || !std::isfinite(in.strength) || in.strength < 0 || in.strength > 2) return false;
+            Input out;
+            if (!out.mask.set(in.mask)) return false;
+            out.masked = in.mask.data != nullptr;
+            out.slot = in.slot; out.width = in.image.width; out.height = in.image.height; out.strength = in.strength;
+            out.rgb.assign(in.image.data, in.image.data + size_t(in.image.width) * in.image.height * 3);
+            next.push_back(std::move(out));
+        }
+        clear_tokens(); inputs_ = std::move(next); return true;
+    }
+    bool prepare(int n_threads) {
+        clear_tokens();
+        std::vector<std::pair<sd::Tensor<float>, sd::Tensor<float>>> next(inputs_.size());
+        for (size_t i = 0; i < inputs_.size(); ++i) {
+            auto& input = inputs_[i];
+            if (input.slot >= models.size()) return false;
+            auto& model = models[input.slot];
+            if (!sd_compute_ip_tokens(model.vision.get(), model.projection.get(), n_threads,
+                {input.width, input.height, 3, input.rgb.data()}, input.strength, next[i].first, next[i].second))
+                return false;
+        }
+        if (sd_should_abort()) return false;
+        tokens_ = std::move(next);
+        for (size_t i = 0; i < inputs_.size(); ++i) {
+            auto& input = inputs_[i];
+            IPAttentionCoverage coverage;
+            if (input.masked) {
+                auto* mask = &input.mask;
+                coverage = [mask](int w, int h) { return mask->coverage(w, h); };
+            }
+            positive_.push_back({input.slot, &tokens_[i].first, input.strength, coverage});
+            negative_.push_back({input.slot, &tokens_[i].second, input.strength, coverage});
+        }
+        return true;
+    }
+};
