+inline std::string sd_indexed_ip_weight_name(const std::string& name, size_t slot) {
+    if (slot >= 64) return {};
+    const auto id = std::to_string(slot);
+    const std::string projection = "ip_adapter.image_proj.";
+    if (starts_with(name, projection)) return "ip_adapter_slots." + id + ".image_proj." + name.substr(projection.size());
+    if (!starts_with(name, "model.diffusion_model.")) return {};
+    for (const auto* role : {"to_k", "to_v"}) {
+        const auto suffix = std::string(".attn2.") + role + "_ip.weight";
+        if (ends_with(name, suffix))
+            return name.substr(0, name.size() - suffix.size()) + ".attn2.ip_adapters." + id + "." + role + ".weight";
+    }
+    return {};
+}
+inline std::string sd_indexed_ip_vision_name(const std::string& name, size_t slot) {
+    if (slot >= 64) return {};
+    const auto prefix = "ip_vision_slots." + std::to_string(slot) + ".";
+    const auto start = name.find("vision_model.");
+    if (start != std::string::npos) return prefix + name.substr(start);
+    if (ends_with(name, "visual_projection.weight")) return prefix + "visual_projection.weight";
+    return {};
+}
+inline bool sd_valid_ip_projection_metadata(const String2TensorStorage& map, const std::string& prefix) {
+    const auto get = [&](const std::string& suffix) -> const TensorStorage* {
+        const auto found = map.find(prefix + ".image_proj." + suffix);
+        return found == map.end() ? nullptr : &found->second;
+    };
+    if (const auto* latents = get("latents")) {
+        const auto* in = get("proj_in.weight"); const auto* out = get("proj_out.weight");
+        const auto* ff = get("layers.0.1.1.weight");
+        const auto dim = latents->ne[0];
+        if (dim < 64 || dim > 4096 || dim % 64 || latents->ne[1] < 1 || latents->ne[1] > 256
+            || latents->ne[2] != 1 || !in || !out || !ff || in->ne[0] < 1 || in->ne[1] != dim
+            || out->ne[0] != dim || out->ne[1] < 1 || ff->ne[0] != dim || ff->ne[1] < 1) return false;
+        size_t depth = 0;
+        while (get("layers." + std::to_string(depth) + ".0.to_q.weight")) ++depth;
+        return depth > 0 && depth <= 16;
+    }
+    const auto* norm = get("norm.weight"); const auto* proj = get("proj.weight");
+    return norm && proj && norm->n_dims == 1 && norm->ne[0] > 0 && norm->ne[0] <= 4096
+        && proj->n_dims == 2 && proj->ne[0] > 0 && proj->ne[0] <= 8192
+        && proj->ne[1] > 0 && proj->ne[1] % norm->ne[0] == 0 && proj->ne[1] / norm->ne[0] <= 256;
+}
+inline bool sd_ip_vision_architecture(const String2TensorStorage& map, const std::string& prefix,
+    CLIPVersion& version, int32_t& projection_dim) {
+    const auto patch = map.find(prefix + ".vision_model.embeddings.patch_embedding.weight");
+    const auto projection = map.find(prefix + ".visual_projection.weight");
+    if (patch == map.end() || projection == map.end()) return false;
+    const auto& p = patch->second; const auto& out = projection->second;
+    if (p.n_dims != 4 || p.ne[0] != 14 || p.ne[1] != 14 || p.ne[2] != 3 || out.n_dims != 2
+        || out.ne[0] != p.ne[3] || out.ne[1] < 1 || out.ne[1] > 8192) return false;
+    switch (p.ne[3]) {
+    case 1024: version = OPENAI_CLIP_VIT_L_14; break;
+    case 1280: version = OPEN_CLIP_VIT_H_14; break;
+    case 1664: version = OPEN_CLIP_VIT_BIGG_14; break;
+    default: return false;
+    }
+    projection_dim = int32_t(out.ne[1]); return true;
+}
