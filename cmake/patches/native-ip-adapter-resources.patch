+bool ModelLoader::append_metadata(const ModelLoader& source,
+    const std::function<std::string(const std::string&)>& rename) {
+    if (model_files_processed || &source == this || !rename) return false;
+    auto paths = file_paths_;
+    String2TensorStorage tensors;
+    // OrderedMap's index holds iterators: rebuild instead of shallow-copying it.
+    for (const auto& item : tensor_storage_map) tensors[item.first] = item.second;
+    size_t added = 0;
+    for (const auto& item : source.tensor_storage_map) {
+        auto tensor = item.second;
+        const auto name = rename(item.first);
+        if (name.empty()) continue;
+        if (tensor.file_index >= source.file_paths_.size() || tensors.find(name) != tensors.end()) return false;
+        const auto& path = source.file_paths_[tensor.file_index];
+        auto found = std::find(paths.begin(), paths.end(), path);
+        tensor.file_index = found == paths.end() ? paths.size() : size_t(found - paths.begin());
+        if (found == paths.end()) paths.push_back(path);
+        tensor.name = name;
+        tensors[name] = std::move(tensor);
+        ++added;
+    }
+    if (!added) return false;
+    file_paths_ = std::move(paths); tensor_storage_map.swap(tensors);
+    return true;
+}
