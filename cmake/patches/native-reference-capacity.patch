+
+SD_API int sd_ctx_reference_image_capacity(const sd_ctx_t* sd_ctx) {
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr) return 0;
+    const auto version = sd_ctx->sd->version;
+    if (sd_version_is_unet_edit(version)) return 1;
+    if (sd_version_supports_ref_latent_img_cfg(version) ||
+        sd_version_is_krea2(version) || sd_version_is_anima(version) ||
+        sd_version_is_sefi_image(version) || version == VERSION_HIDREAM_O1) {
+        return 20;
+    }
+    return 0;
+}
