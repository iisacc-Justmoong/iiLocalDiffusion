--- /dev/null
+++ b/src/runtime/control_region_mask.hpp
@@ -0,0 +1,60 @@
+#pragma once
+#include "stable-diffusion.h"
+#include "core/tensor.hpp"
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <utility>
+#include <vector>
+
+// Per-request, owning spatial coverage. No model or GUI dependencies.
+class ControlRegionMask {
+    int width_ = 0, height_ = 0;
+    std::vector<float> coverage_;
+    std::map<std::pair<int, int>, std::vector<float>> scales_;
+public:
+    bool set(sd_image_t image) {
+        if (!image.data && image.width == 0 && image.height == 0 && image.channel == 0) {
+            coverage_.clear(); scales_.clear(); width_ = height_ = 0; return true;
+        }
+        if (!image.data || image.width < 1 || image.height < 1 || image.width > 2048 || image.height > 2048
+            || (image.channel != 1 && image.channel != 3 && image.channel != 4)) return false;
+        std::vector<float> next(size_t(image.width) * image.height);
+        for (size_t i = 0; i < next.size(); ++i) {
+            const auto* pixel = image.data + i * image.channel;
+            next[i] = image.channel == 1 ? float(pixel[0]) / 255.f
+                : float(77 * pixel[0] + 150 * pixel[1] + 29 * pixel[2]) / (256.f * 255.f);
+            if (image.channel == 4) next[i] *= float(pixel[3]) / 255.f;
+        }
+        coverage_ = std::move(next); width_ = int(image.width); height_ = int(image.height);
+        scales_.clear(); return true;
+    }
+    bool apply(std::vector<sd::Tensor<float>>& residuals) {
+        if (coverage_.empty()) return true;
+        // Validate all shapes before modifying any residual.
+        for (const auto& tensor : residuals)
+            if (tensor.dim() < 2 || tensor.empty() || tensor.shape()[0] < 1 || tensor.shape()[1] < 1
+                || tensor.shape()[0] > 4096 || tensor.shape()[1] > 4096) return false;
+        for (auto& tensor : residuals) {
+            const int width = int(tensor.shape()[0]), height = int(tensor.shape()[1]);
+            auto [it, inserted] = scales_.try_emplace({width, height});
+            auto& scale = it->second;
+            if (inserted) {
+                scale.resize(size_t(width) * height);
+                for (int y = 0; y < height; ++y) for (int x = 0; x < width; ++x) {
+                    const float sx = std::clamp((float(x) + .5f) * float(width_) / float(width) - .5f, 0.f, float(width_ - 1));
+                    const float sy = std::clamp((float(y) + .5f) * float(height_) / float(height) - .5f, 0.f, float(height_ - 1));
+                    const int x0 = int(sx), y0 = int(sy), x1 = std::min(x0 + 1, width_ - 1), y1 = std::min(y0 + 1, height_ - 1);
+                    const float dx = sx - float(x0), dy = sy - float(y0);
+                    const auto at = [&](int px, int py) { return coverage_[size_t(py) * width_ + px]; };
+                    scale[size_t(y) * width + x] =
+                        (at(x0, y0) * (1.f - dx) + at(x1, y0) * dx) * (1.f - dy)
+                        + (at(x0, y1) * (1.f - dx) + at(x1, y1) * dx) * dy;
+                }
+            }
+            // Spatial planes repeat for every feature channel and batch.
+            for (size_t i = 0; i < tensor.values().size(); ++i) tensor.values()[i] *= scale[i % scale.size()];
+        }
+        return true;
+    }
+};
