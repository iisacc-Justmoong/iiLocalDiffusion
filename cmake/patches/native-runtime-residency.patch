+ResidentSourceRuntime& resident_source_runtime() {
+    // Keep the control block valid for late engine atexit callbacks, even when
+    // resident mode was first used after a nonresident context registered one.
+    // Explicit runtime release destroys all retained source allocations.
+    static auto* runtime = new ResidentSourceRuntime;
+    return *runtime;
+}
+std::string resident_source_identity(const std::string& filename) {
+    const auto path = std::filesystem::canonical(filename);
+    struct stat info {};
+    if (stat(path.string().c_str(), &info) != 0 || info.st_size <= 0)
+        throw std::runtime_error("Cannot identify resident model source");
+    std::ostringstream key;
+    key << path.string() << '\n' << info.st_dev << ':' << info.st_ino << ':' << info.st_size
+        << ':' << info.st_mtime
+        << ':' << info.st_ctime;
+#if defined(__APPLE__)
+    key << ':' << info.st_ctimespec.tv_nsec << ':' << info.st_mtimespec.tv_nsec;
+#elif !defined(_WIN32)
+    key << ':' << info.st_ctim.tv_nsec << ':' << info.st_mtim.tv_nsec;
+#endif
+    return key.str();
+}
+}
+
+void sd_release_resident_model_memory(void) {
+    auto& runtime = resident_source_runtime();
+    const std::lock_guard<std::mutex> lock(runtime.mutex);
+    runtime.sources.clear();
+}
 
