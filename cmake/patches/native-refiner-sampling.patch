+SD_API bool sd_ctx_can_refine(const sd_ctx_t* base, const sd_ctx_t* refiner) {
+    if (!base || !refiner || !base->sd || !refiner->sd || base->sd == refiner->sd) return false;
+    const auto base_version = base->sd->version;
+    const bool supported_base = base_version == VERSION_SDXL || base_version == VERSION_SDXL_VEGA ||
+                                base_version == VERSION_SDXL_SSD1B;
