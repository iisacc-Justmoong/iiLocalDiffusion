+        !base->sd->diffusion_model || !refiner->sd->diffusion_model ||
+        !base->sd->cond_stage_model || !refiner->sd->cond_stage_model) return false;
+    // These denoisers share additive noise and the SDXL latent normalization.
+    // EDM/flow checkpoints do not have this contract.
+    const auto* base_denoiser = base->sd->denoiser.get();
+    const auto* refiner_denoiser = refiner->sd->denoiser.get();
