# Resolve the compiler's actual default instead of MLX's host patch version.
function(iild_macos_target_from_predefines output predefines)
    string(REGEX MATCH "(^|\n)[ \t]*#define[ \t]+__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__[ \t]+([0-9]+)" match "${predefines}")
    if(NOT match)
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    set(encoded "${CMAKE_MATCH_2}")
    math(EXPR major "${encoded} / 10000")
    math(EXPR minor "(${encoded} / 100) % 100")
    math(EXPR patch "${encoded} % 100")
    set(${output} "${major}.${minor}.${patch}" PARENT_SCOPE)
endfunction()

function(iild_mlx_deployment_target output)
    if(CMAKE_OSX_DEPLOYMENT_TARGET)
        set(${output} "${CMAKE_OSX_DEPLOYMENT_TARGET}" PARENT_SCOPE)
        return()
    endif()
    set(command "${CMAKE_CXX_COMPILER}")
    if(CMAKE_CXX_COMPILER_ARG1)
        separate_arguments(compiler_arg NATIVE_COMMAND "${CMAKE_CXX_COMPILER_ARG1}")
        list(APPEND command ${compiler_arg})
    endif()
    if(CMAKE_CXX_COMPILER_TARGET)
        list(APPEND command -target "${CMAKE_CXX_COMPILER_TARGET}")
    endif()
    if(CMAKE_CXX_FLAGS)
        separate_arguments(compiler_flags NATIVE_COMMAND "${CMAKE_CXX_FLAGS}")
        list(APPEND command ${compiler_flags})
    endif()
    if(CMAKE_OSX_SYSROOT AND IS_DIRECTORY "${CMAKE_OSX_SYSROOT}")
        list(APPEND command -isysroot "${CMAKE_OSX_SYSROOT}")
    endif()
    if(CMAKE_OSX_ARCHITECTURES)
        list(GET CMAKE_OSX_ARCHITECTURES 0 architecture)
        list(APPEND command -arch "${architecture}")
    endif()
    list(APPEND command -dM -E -x c++ /dev/null)
    execute_process(COMMAND ${command} RESULT_VARIABLE status
        OUTPUT_VARIABLE predefines ERROR_VARIABLE diagnostics)
    iild_macos_target_from_predefines(target "${predefines}")
    if(NOT status STREQUAL "0" OR NOT target)
        message(FATAL_ERROR "Cannot determine the compiler's macOS deployment target. Set CMAKE_OSX_DEPLOYMENT_TARGET explicitly. ${diagnostics}")
    endif()
    set(${output} "${target}" PARENT_SCOPE)
endfunction()
