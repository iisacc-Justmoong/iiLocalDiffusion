#!/usr/bin/env python3
"""Run an installed SDK command with the selected local Python environment."""

import json
import subprocess
import os
from pathlib import Path
import shutil
import sys


def main():
    reference = (Path(__file__).resolve().parent / "@IILD_REFERENCE_FROM_BINDIR@").resolve()
    entry = reference / "@IILD_PYTHON_ENTRY@"
    if not entry.is_file():
        sys.exit(f"Installed Python entry point is missing: {entry}")
    requested = os.environ.get("IILD_PYTHON_EXECUTABLE")
    if requested:
        selected = shutil.which(str(Path(requested).expanduser()))
        if selected is None:
            sys.exit(f"IILD_PYTHON_EXECUTABLE is not an executable: {requested}")
        interpreter = Path(selected).absolute()
    else:
        environment = reference / "diffusers/.venv"
        candidate = environment / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
        configuration = reference / "runtime-python.json"
        if configuration.is_file():
            try:
                interpreter = Path(json.loads(configuration.read_text())["python"]).expanduser()
            except (ValueError, KeyError, TypeError) as error:
                sys.exit(f"Invalid SDK Python configuration {configuration}: {error}")
        else:
            interpreter = candidate if candidate.is_file() else Path(sys.executable)
    try:
        probe = subprocess.run([str(interpreter), "-c",
            "import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)"],
            capture_output=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as error:
        sys.exit(f"Cannot start SDK Python {interpreter}: {error}. Configure runtime-python.json or IILD_PYTHON_EXECUTABLE.")
    if probe.returncode:
        sys.exit(f"iiLocalDiffusion requires Python 3.10 or newer; selected {interpreter}. "
                 "Configure runtime-python.json or IILD_PYTHON_EXECUTABLE with the SDK environment.")
    # Keep virtual-environment paths intact; resolving their symlinks loses the environment.
    os.execv(str(interpreter), [str(interpreter), str(entry), *sys.argv[1:]])


if __name__ == "__main__":
    main()
