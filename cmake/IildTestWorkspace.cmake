if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
    find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
    set(_iild_test_runner "${Python3_EXECUTABLE}" -B
        "${CMAKE_CURRENT_SOURCE_DIR}/tests/resource_runner.py" auto
        "${CMAKE_CURRENT_SOURCE_DIR}/resources")
    add_test(NAME ResourceWorkspaceTests COMMAND ${_iild_test_runner}
        "${Python3_EXECUTABLE}" -B "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_resource_runner.py")
endif()

function(iild_resource_test name target)
    if(CMAKE_CROSSCOMPILING)
        set(_args)
        foreach(_arg IN LISTS ARGN)
            string(REPLACE "@WORK@" "${CMAKE_CURRENT_SOURCE_DIR}/resources/test-workspaces/cross" _arg "${_arg}")
            list(APPEND _args "${_arg}")
        endforeach()
        add_test(NAME "${name}" COMMAND "${target}" ${_args})
    else()
        add_test(NAME "${name}" COMMAND ${_iild_test_runner} "$<TARGET_FILE:${target}>" ${ARGN})
    endif()
endfunction()

function(iild_resource_script_test name)
    if(CMAKE_CROSSCOMPILING)
        set(_args)
        foreach(_arg IN LISTS ARGN)
            string(REPLACE "@WORK@" "${CMAKE_CURRENT_SOURCE_DIR}/resources/test-workspaces/cross" _arg "${_arg}")
            string(REPLACE "@BUILD_WORK@" "${CMAKE_CURRENT_BINARY_DIR}/test-workspaces/cross" _arg "${_arg}")
            list(APPEND _args "${_arg}")
        endforeach()
        add_test(NAME "${name}" COMMAND ${_args})
    else()
        add_test(NAME "${name}" COMMAND ${_iild_test_runner} ${ARGN})
    endif()
endfunction()
